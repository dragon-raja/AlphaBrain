{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "common.schema.json",
  "title": "DSOL Paper 1 Common Artifact Envelope",
  "description": "Common provenance, identity, hash, and status definitions for DSOL Paper 1 artifacts.",
  "$ref": "#/$defs/artifact_envelope",
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Z][A-Z0-9_:-]*$"
    },
    "hash": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "digest"
      ],
      "properties": {
        "algorithm": {
          "const": "sha256"
        },
        "digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "kind",
        "location",
        "hash",
        "status"
      ],
      "properties": {
        "source_id": {
          "$ref": "#/$defs/identifier"
        },
        "kind": {
          "enum": [
            "ARTIFACT",
            "CHECKPOINT",
            "CONFIG",
            "DATASET",
            "RUNTIME",
            "SNAPSHOT_BANK",
            "OTHER"
          ]
        },
        "location": {
          "$ref": "#/$defs/non_empty_string"
        },
        "hash": {
          "$ref": "#/$defs/hash"
        },
        "status": {
          "$ref": "#/$defs/status"
        }
      }
    },
    "code": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code_id",
        "repository",
        "revision",
        "content_hash",
        "entrypoint",
        "dirty",
        "status"
      ],
      "properties": {
        "code_id": {
          "$ref": "#/$defs/identifier"
        },
        "repository": {
          "$ref": "#/$defs/non_empty_string"
        },
        "revision": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{7,64}$"
        },
        "content_hash": {
          "$ref": "#/$defs/hash"
        },
        "entrypoint": {
          "$ref": "#/$defs/non_empty_string"
        },
        "dirty": {
          "type": "boolean"
        },
        "status": {
          "$ref": "#/$defs/status"
        }
      }
    },
    "artifact_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "hash",
        "status"
      ],
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/identifier"
        },
        "hash": {
          "$ref": "#/$defs/hash"
        },
        "status": {
          "$ref": "#/$defs/status"
        }
      }
    },
    "artifact_envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id",
        "artifact_id",
        "schema_version",
        "created_at",
        "source",
        "code",
        "hash",
        "status"
      ],
      "properties": {
        "schema_id": {
          "$ref": "#/$defs/identifier"
        },
        "artifact_id": {
          "$ref": "#/$defs/identifier"
        },
        "schema_version": {
          "type": "string",
          "pattern": "^[1-9][0-9]*\\.[0-9]+\\.[0-9]+$"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "source": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/source"
          }
        },
        "code": {
          "$ref": "#/$defs/code"
        },
        "hash": {
          "$ref": "#/$defs/hash"
        },
        "status": {
          "$ref": "#/$defs/status"
        }
      }
    }
  }
}
