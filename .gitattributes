*.py text eol=lf
*.sh text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
# Markdown uses trailing spaces for intentional hard line breaks.
*.md text eol=lf whitespace=-blank-at-eol,-blank-at-eof
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
# Frozen evidence must retain exact bytes, including historical whitespace.
archive/** -text -whitespace
docs/dsol_paper1/reports/sources/** whitespace=-blank-at-eof
