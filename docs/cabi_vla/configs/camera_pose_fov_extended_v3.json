      "stop": 180.0,
      "step": 2.5
    },
    {
      "parameter": "elevation_deg",
      "start": -80.0,
      "stop": 52.0,
      "step": 2.0
    },
    {
      "parameter": "radius_scale",
      "start": 0.3,
      "stop": 2.0,
      "step": 0.025
    }
  ]
