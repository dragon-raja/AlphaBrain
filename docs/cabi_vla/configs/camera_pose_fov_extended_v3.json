{
  "schema_version": 1,
  "name": "libero_bind_camera_pose_fov_extended_v3",
  "camera_name": "agentview",
  "table_plane_z": 0.48,
  "design": "one_factor_at_a_time_extended_visibility",
  "purpose": "Locate center-exit, border-truncation, disappearance, and small-object boundaries rather than stopping inside the valid field of view.",
