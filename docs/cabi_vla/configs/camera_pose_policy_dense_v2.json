{
  "schema_version": 1,
  "name": "libero_bind_camera_pose_policy_dense_v2",
  "camera_name": "agentview",
  "table_plane_z": 0.48,
  "design": "one_factor_at_a_time_dense_closed_loop",
  "purpose": "Measure fixed-policy response at substantially finer pose resolution inside the practical camera neighborhood.",
