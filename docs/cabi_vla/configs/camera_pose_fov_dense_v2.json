{
  "schema_version": 1,
  "name": "libero_bind_camera_pose_fov_dense_v2",
  "camera_name": "agentview",
  "table_plane_z": 0.48,
  "design": "one_factor_at_a_time_dense_visibility",
  "purpose": "Locate geometric, truncation, occlusion, and small-object visibility boundaries before policy evaluation.",
  "fixed_variables": {
    "wrist_camera": "unchanged",
    "field_of_view": "unchanged",
    "resolution": 224,
    "minimum_visible_pixels": 64
  },
  "one_factor_axes": [
    {
      "parameter": "azimuth_deg",
      "start": -90.0,
      "stop": 90.0,
      "step": 2.5
    },
    {
      "parameter": "elevation_deg",
      "start": -30.0,
      "stop": 30.0,
      "step": 2.0
    },
    {
      "parameter": "radius_scale",
      "start": 0.6,
      "stop": 1.5,
      "step": 0.025
    }
  ]
}
