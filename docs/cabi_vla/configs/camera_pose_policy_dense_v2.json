    "resolution": 224,
    "minimum_visible_pixels": 64
  },
  "one_factor_axes": [
    {
      "parameter": "azimuth_deg",
      "start": -30.0,
      "stop": 30.0,
      "step": 5.0
    },
    {
      "parameter": "elevation_deg",
      "start": -15.0,
      "stop": 15.0,
      "step": 3.0
    },
    {
      "parameter": "radius_scale",
      "start": 0.85,
      "stop": 1.15,
      "step": 0.025
    }
  ]
}
